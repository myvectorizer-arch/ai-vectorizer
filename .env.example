# Postgres connection used by the app and by drizzle-kit (db:push / db:generate / db:studio)
# Uploaded images, cached traces, app settings, users — everything lives here.
# A free Postgres (e.g. Neon) is enough; no separate file storage/disk is needed.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Session signing secret — set a long random string, never commit the real value
JWT_SECRET=

# Default admin login (change these in production)
ADMIN_EMAIL=admin@vectorizer.ai
ADMIN_PASSWORD=admin12345

# Google login (optional — leave blank to keep Google login disabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
